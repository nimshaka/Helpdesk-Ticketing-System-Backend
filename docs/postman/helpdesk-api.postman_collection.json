                "exec": [
                  "const body = pm.response.json();\r\n\r\npm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });\r\npm.test(\"Reply and ticket status returned\", function () {\r\n    pm.expect(body.success).to.eql(true);\r\n    pm.expect(body.data.reply).to.have.property(\"author\");\r\n    pm.expect(body.data.ticket.status).to.have.property(\"value\");\r\n});"
                ]

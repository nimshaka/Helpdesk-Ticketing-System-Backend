        {
          "name": "List tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\npm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });\r\npm.test(\"Standard shape with pagination\", function () {\r\n    pm.expect(body.success).to.eql(true);\r\n    pm.expect(body.data).to.be.an(\"array\");\r\n    pm.expect(body.meta).to.have.property(\"total\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tickets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "tickets"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Printer",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "in_progress",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "assignment",
                  "value": "unassigned",
                  "disabled": true
                },
                {
                  "key": "per_page",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Show ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\npm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });\r\npm.test(\"Has the ticket parts\", function () {\r\n    pm.expect(body.success).to.eql(true);\r\n    pm.expect(body.data).to.have.property(\"replies\");\r\n    pm.expect(body.data).to.have.property(\"status_history\");\r\n});\r\npm.test(\"Replies are in chronological order\", function () {\r\n    const times = body.data.replies.map(r => new Date(r.created_at).getTime());\r\n    pm.expect(times).to.eql([...times].sort((a, b) => a - b));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/tickets/{{ticket_id}}",
              "host": [

    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\npm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });\r\npm.test(\"Standard shape\", function () {\r\n    pm.expect(body.success).to.eql(true);\r\n    pm.expect(body.data.counts).to.have.lengthOf(4);\r\n    pm.expect(body.data.recent_activity).to.be.an(\"array\");\r\n    pm.expect(body.data.recent_activity.length).to.be.at.most(10);\r\n});\r\npm.test(\"The four counts add up to total\", function () {\r\n    const sum = body.data.counts.reduce((a, c) => a + c.count, 0);\r\n    pm.expect(sum).to.eql(body.data.total);\r\n});\r\npm.test(\"Activity is newest first\", function () {\r\n    const times = body.data.recent_activity.map(a => new Date(a.occurred_at).getTime());\r\n    pm.expect(times).to.eql([...times].sort((a, b) => b - a));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "dashboard"
              ]
            }
          },
          "response": []
        }
      ]

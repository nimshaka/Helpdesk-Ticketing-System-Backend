    {
      "name": "Tickets",
      "item": [
        {
          "name": "Create ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\r\n\r\npm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });\r\npm.test(\"Ticket starts as open\", function () {\r\n    pm.expect(body.success).to.eql(true);\r\n    pm.expect(body.data.status.value).to.eql(\"open\");\r\n});\r\n\r\nif (body.success) { pm.environment.set(\"ticket_id\", body.data.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"subject\":\"laptop is not working\",\r\n    \"description\":\"It shows error E-10.\",\r\n    \"priority\":\"high\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
